generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  FARMER
  ADMIN
}

enum ToolCategory {
  CLIMBING_POLES
  TILLERS
  NETS_COVERS
  TRANSPLANTERS
  SPRAYERS
  PRUNERS_CUTTERS
  WATER_PUMPS
  HARVESTING_TOOLS
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  RETURNED
  CANCELLED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  FAILED
}

enum DeliveryStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  PICKED_UP
  RETURNED
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  name            String?
  phone           String   @unique
  email           String?  @unique
  passwordHash    String?
  role            UserRole @default(FARMER)
  district        String?
  taluk           String?
  village         String?
  pincode         String?
  phoneVerified   Boolean  @default(false)
  aadhaarVerified Boolean  @default(false)
  preferredLang   String   @default("kn")
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings   Booking[]
  reviews    Review[]

  accounts Account[]
  sessions Session[]

  @@map("users")
}

// ─── NextAuth Models ────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── OTP Requests ───────────────────────────────────────────────────────────

model OtpRequest {
  id         String   @id @default(cuid())
  phone      String
  otp        String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  ip         String?

  @@index([phone, otp])
  @@index([expiresAt])
  @@map("otp_requests")
}

// ─── Rate Limit ──────────────────────────────────────────────────────────────

model RateLimit {
  id        String   @id @default(cuid())
  key       String   // "phone:9876543210" or "ip:127.0.0.1"
  count     Int      @default(1)
  windowStart DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([key, windowStart])
  @@index([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limits")
}

// ─── Tool ───────────────────────────────────────────────────────────────────

model Tool {
  id                   String       @id @default(cuid())
  name                 String
  nameKn               String?
  slug                 String       @unique
  description          String       @db.Text
  descriptionKn        String?
  category             ToolCategory @default(OTHER)
  images               String[]
  thumbnailUrl         String?
  pricePerDay          Int
  pricePerWeek         Int?
  pricePerSeason       Int?
  deposit              Int
  availableCount       Int          @default(0)
  totalCount           Int          @default(0)
  minRentalDays        Int          @default(1)
  maxRentalDays        Int          @default(30)
  specs                Json?
  isActive             Boolean      @default(true)
  isFeatured           Boolean      @default(false)
  deliveryAvailable    Boolean      @default(true)
  deliveryRadiusKm     Int          @default(50)
  freeDeliveryRadiusKm Int          @default(20)
  deliveryChargePerKm  Int?         @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@map("tools")
}

// ─── Booking (was Rental) ───────────────────────────────────────────────────

model Booking {
  id                String         @id @default(cuid())
  bookingRef        String         @unique
  userId            String
  toolId            String
  startDate         DateTime
  endDate           DateTime
  totalDays         Int
  pricePerDay       Int
  subtotal          Int
  deposit           Int
  deliveryCharge    Int            @default(0)
  totalAmount       Int
  status            BookingStatus  @default(PENDING)
  deliveryStatus    DeliveryStatus @default(SCHEDULED)
  deliveryAddress   String?
  deliveryDistrict  String?
  deliveryTaluk     String?
  deliveryPincode   String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  tool    Tool     @relation(fields: [toolId], references: [id])
  payment Payment?

  @@map("bookings")
}

// ─── Payment ────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Int
  status            PaymentStatus @default(PENDING)
  method            String?
  vpa               String?
  webhookVerified   Boolean       @default(false)
  webhookReceivedAt DateTime?
  createdAt         DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

// ─── Review ─────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  rating    Int
  comment   String?  @db.Text
  commentKn String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  tool Tool @relation(fields: [toolId], references: [id])

  @@unique([userId, toolId])
  @@map("reviews")
}

// ─── Inventory Log ──────────────────────────────────────────────────────────

model InventoryLog {
  id        String   @id @default(cuid())
  toolId    String
  change    Int
  reason    String
  bookingId String?
  createdAt DateTime @default(now())

  @@map("inventory_logs")
}
