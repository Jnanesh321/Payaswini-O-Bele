        android:layout_height="0dp"
        app:designRootWidth="390"
        app:designRootHeight="844"
        app:designAutoSizeMinTextSize="1.0"
        app:designAutoSizeMaxTextSize="1.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/f_onboarding_role_selection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_f_onboarding_role_selection" >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/f_top_content1"
                android:layout_width="match_parent"
                android:layout_height="644dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="0dp" >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/f_status_bar5"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="0dp" >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/f_status_icons2"
                        android:layout_width="80dp"
                        android:layout_height="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="286dp"
                        android:layout_marginTop="12dp" >

                        <ImageView
                            android:id="@+id/f_ios_signal5"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginTop="0dp"
                            android:src="@drawable/img_f_ios_signal5"
                            android:scaleType="centerInside"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/f_ios_wifi_signal5"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="26dp"
                            android:src="@drawable/img_f_ios_wifi_signal5"
                            android:scaleType="centerInside"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/f_ios_battery_full5"
                            android:layout_width="28dp"
                            android:layout_height="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="52dp"
                            android:src="@drawable/img_f_ios_battery_full5"
                            android:scaleType="centerInside"
                            android:contentDescription="@null" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/tv_9415"
                        android:layout_width="27dp"
                        android:layout_height="17dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="13.5dp"
                        android:text="@string/s_941"
                        android:textSize="13dp"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:gravity="start|center_vertical"
                        android:textAlignment="viewStart"
                        android:textColor="@color/color_text_tv_9415" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/f_welcome_section"
                    android:layout_width="match_parent"
                    android:layout_height="252dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/f_status_bar5"
                    android:layout_marginTop="0dp" >

                    <ImageView
                        android:id="@+id/f_brand_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="40dp"
                        android:src="@drawable/img_f_brand_icon"
                        android:scaleType="centerInside"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_what_brings_you_to_obele"
                        android:layout_width="342dp"
                        android:layout_height="74dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:text="@string/what_brings_you_to_obele"
                        android:textSize="30dp"
                        android:includeFontPadding="false"
                        android:gravity="start|center_vertical"
                        android:textAlignment="viewStart"
                        android:textColor="@color/color_text_tv_what_brings_you_to_obele"
                        app:layout_constraintTop_toBottomOf="@id/f_brand_icon"
                        android:layout_marginTop="12dp" />

                    <!-- app:fillRanges="0,68,color_text_tv_choose_your_journey_on|68,90,color_text_tv_choose_your_journey_on_2" -->
                    <TextView
                        android:id="@+id/tv_choose_your_journey_on"
                        android:layout_width="342dp"
                        android:layout_height="46dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:text="@string/choose_your_journey_on_karnatakas"
                        android:textSize="14dp"
                        android:includeFontPadding="false"
                        android:gravity="start|center_vertical"
                        android:textAlignment="viewStart"
                        android:textColor="@color/color_text_tv_choose_your_journey_on"
                        app:layout_constraintTop_toBottomOf="@id/tv_what_brings_you_to_obele"
                        android:layout_marginTop="12dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/f_role_list"
                    android:layout_width="match_parent"
                    android:layout_height="348dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/f_welcome_section"
                    android:layout_marginTop="0dp" >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/f_farmer_card"
                        android:layout_width="342dp"
                        android:layout_height="98dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="24dp"
                        android:background="@drawable/bg_f_farmer_card" >

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/f_details_block"
                            android:layout_width="198dp"
                            android:layout_height="58dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="84dp"
                            android:layout_marginTop="20dp" >

                            <TextView
                                android:id="@+id/tv_i_need_to_rent_tools"
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginTop="0dp"
                                android:text="@string/i_need_to_rent_tools"
                                android:textSize="17dp"
                                android:includeFontPadding="false"
                                android:textStyle="bold"
                                android:gravity="start|center_vertical"
                                android:textAlignment="viewStart"
                                android:textColor="@color/color_text_tv_i_need_to_rent_tools" />

                            <TextView
                                android:id="@+id/tv_find_tillers_harvesters_tractors_nearby"
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:text="@string/find_tillers_harvesters_tractors_nearby"
                                android:textSize="12dp"
                                android:includeFontPadding="false"
                                android:gravity="start|center_vertical"
                                android:textAlignment="viewStart"
                                android:textColor="@color/color_text_tv_find_tillers_harvesters_tractors_nearby"
                                app:layout_constraintTop_toBottomOf="@id/tv_i_need_to_rent_tools"
                                android:layout_marginTop="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <ImageView
                            android:id="@+id/f_icon_block"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="25dp"
                            android:src="@drawable/img_f_icon_block"
                            android:scaleType="centerInside"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/f_checkbox"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="298dp"
                            android:layout_marginTop="37dp"
                            android:src="@drawable/img_f_checkbox"
                            android:scaleType="centerInside"
                            android:contentDescription="@null"
                            android:clipToOutline="true"
                            android:background="@drawable/shape_f_checkbox_circle" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/f_owner_card"
                        android:layout_width="342dp"
                        android:layout_height="98dp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="24dp"
                        android:background="@drawable/bg_f_owner_card"
                        app:layout_constraintTop_toBottomOf="@id/f_farmer_card"
                        android:layout_marginTop="16dp" >

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/f_details_block1"
                            android:layout_width="198dp"
                            android:layout_height="58dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="84dp"
                            android:layout_marginTop="20dp" >

                            <TextView
                                android:id="@+id/tv_i_have_tools_to_rent_out"
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginTop="0dp"
                                android:text="@string/i_have_tools_to_rent_out"
                                android:textSize="17dp"
                                android:includeFontPadding="false"
                                android:textStyle="bold"
                                android:gravity="start|center_vertical"
                                android:textAlignment="viewStart"
                                android:textColor="@color/color_text_tv_i_have_tools_to_rent_out" />

                            <TextView
                                android:id="@+id/tv_list_your_equipment_start_earning"
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:text="@string/list_your_equipment_start_earning"
                                android:textSize="12dp"
                                android:includeFontPadding="false"
                                android:gravity="start|center_vertical"
                                android:textAlignment="viewStart"
                                android:textColor="@color/color_text_tv_list_your_equipment_start_earning"
                                app:layout_constraintTop_toBottomOf="@id/tv_i_have_tools_to_rent_out"
                                android:layout_marginTop="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <ImageView
                            android:id="@+id/f_icon_block1"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="25dp"
                            android:src="@drawable/img_f_icon_block1"
                            android:scaleType="centerInside"
                            android:contentDescription="@null" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/f_checkbox1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="298dp"
                            android:layout_marginTop="37dp"
                            android:background="@drawable/bg_f_checkbox1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/f_operator_card"
                        android:layout_width="342dp"
                        android:layout_height="120dp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="24dp"
                        android:background="@drawable/bg_f_operator_card"
                        app:layout_constraintTop_toBottomOf="@id/f_owner_card"
                        android:layout_marginTop="16dp" >

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/f_details_block2"
                            android:layout_width="198dp"
                            android:layout_height="80dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="84dp"
                            android:layout_marginTop="20dp" >

                            <TextView
                                android:id="@+id/tv_i_can_operate_equipment"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginTop="0dp"
                                android:text="@string/i_can_operate_equipment"
                                android:textSize="17dp"
                                android:includeFontPadding="false"
                                android:textStyle="bold"
                                android:gravity="start|center_vertical"
                                android:textAlignment="viewStart"
                                android:textColor="@color/color_text_tv_i_can_operate_equipment" />

                            <TextView
                                android:id="@+id/tv_get_hired_for_harvesting_and_tilling_shifts"
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:text="@string/get_hired_for_harvesting_and_tilling"
                                android:textSize="12dp"
                                android:includeFontPadding="false"
                                android:gravity="start|center_vertical"
                                android:textAlignment="viewStart"
                                android:textColor="@color/color_text_tv_get_hired_for_harvesting_and_tilling_shifts"
                                app:layout_constraintTop_toBottomOf="@id/tv_i_can_operate_equipment"
                                android:layout_marginTop="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <ImageView
                            android:id="@+id/f_icon_block2"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="36dp"
                            android:src="@drawable/img_f_icon_block2"
                            android:scaleType="centerInside"
                            android:contentDescription="@null" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/f_checkbox2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="298dp"
                            android:layout_marginTop="48dp"
                            android:background="@drawable/bg_f_checkbox2" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/f_bottom_actions1"
                android:layout_width="match_parent"
                android:layout_height="152dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@color/color_f_bottom_actions1"
                app:layout_constraintTop_toBottomOf="@id/f_top_content1"
                android:layout_marginTop="48dp" >

                <!-- EditText -->
                <android.widget.EditText
                    android:id="@+id/f_disclaimer_group"
                    android:layout_width="342dp"
                    android:layout_height="13dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:hint="@string/by_continuing_you_agree_to_local"
                    android:textSize="10dp"
                    android:textColorHint="#6b706e" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/f_continue_button"
                    android:layout_width="342dp"
                    android:layout_height="54dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_f_continue_button"
                    app:layout_constraintTop_toBottomOf="@id/f_disclaimer_group"
                    android:layout_marginTop="16dp" >

                    <TextView
                        android:id="@+id/tv_continue"
                        android:layout_width="71dp"
                        android:layout_height="19dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="122.5dp"
                        android:layout_marginTop="17.5dp"
                        android:text="@string/continue_text"
                        android:textSize="15dp"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:gravity="start|center_vertical"
                        android:textAlignment="viewStart"
                        android:textColor="@color/color_text_tv_continue" />

                    <ImageView
                        android:id="@+id/f_arrow_right6"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="201.5dp"
                        android:layout_marginTop="18dp"
                        android:src="@drawable/img_f_arrow_right6"
                        android:scaleType="centerInside"
                        android:contentDescription="@null" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/f_home_indicator1"
                    android:layout_width="342dp"
                    android:layout_height="33dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="24dp"
                    app:layout_constraintTop_toBottomOf="@id/f_continue_button"
                    android:layout_marginTop="16dp" >

                    <View
                        android:id="@+id/rect_rectangle7"
                        android:layout_width="134dp"
                        android:layout_height="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="104dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_rect_rectangle7" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </in.obele.app.code_gen_export.common.views.DesignScaleFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
